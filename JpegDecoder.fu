class JpegHuffmanTable
{
	internal byte[16] NBitCodeCount;
	internal byte[256] Symbols;
}

class JpegComponentState
{
	internal int Dc = 0;
	internal byte[] QuantizationTable;
	internal JpegHuffmanTable DcHuffmanTable;
	internal JpegHuffmanTable AcHuffmanTable;
}

/// Decoder of the JPEG bitmap format.
public class JpegDecoder : ImageDecoder
{
	public JpegDecoder()
	{
	}

	int Components;
	int ColorSamplingH;
	int ColorSamplingV;

	ushort ReadWord!() throws ImageFormatException
	{
		int hi = ReadByte();
		int lo = ReadByte();
		return (hi << 8) | lo;
	}

	void ReadBytes!(byte[]! result, int length) throws ImageFormatException
	{
		for (int i = 0; i < length; i++)
			result[i] = ReadByte();
	}

	int Bits;

	uint ReadBit!() throws ImageFormatException
	{
		if ((Bits & 0x7f) == 0) {
			int value = ReadByte();
			if (value == 0xff && ReadByte() != 0)
				throw ImageFormatException("Expected FF 00");
			Bits = value << 1 | 1;
		}
		else
			Bits <<= 1;
		return Bits >> 8 & 1;
	}

	short ReadSignedBits!(int n) throws ImageFormatException
	{
		if (n == 0)
			return 0;
		int result = ReadBit();
		if (result == 0)
			result = -2;
		while (--n > 0)
			result = result << 1 | ReadBit();
		if (result < 0)
			result++;
		return result;
	}

	byte ReadCode!(JpegHuffmanTable table) throws ImageFormatException
	{
		int offset = 0;
		int code = 0;
		for (int bits = 1; bits <= 16; bits++) {
			code += ReadBit();
			int n = table.NBitCodeCount[bits - 1];
			if (code < n)
				return table.Symbols[offset + code];
			offset += n;
			code = code - n << 1;
		}
		throw ImageFormatException("Unassigned code");
	}

	static int Clamp(int b) => b < 0 ? 0 : b > 255 ? 255 : b;

	void ReadBlock!(JpegComponentState! component, int bitPosition, int lastCoefficient, int pixelsOffset, int pixelsStride) throws ImageFormatException
	{
		int code = ReadCode(component.DcHuffmanTable);
		if (code > 11)
			throw ImageFormatException("Invalid DC code");
		component.Dc += ReadSignedBits(code);
		short[64] dctCoeffs = 0;
		for (int i = 1; i <= lastCoefficient; i++) {
			code = ReadCode(component.AcHuffmanTable);
			if (code == 0)
				break;
			i += code >> 4;
			if (i > lastCoefficient)
				throw ImageFormatException("Invalid AC code");
			const byte[] zigzag = {
				 0,  1,  8, 16,  9,  2,  3, 10,
				17, 24, 32, 25, 18, 11,  4,  5,
				12, 19, 26, 33, 40, 48, 41, 34,
				27, 20, 13,  6,  7, 14, 21, 28,
				35, 42, 49, 56, 57, 50, 43, 36,
				29, 22, 15, 23, 30, 37, 44, 51,
				58, 59, 52, 45, 38, 31, 39, 46,
				53, 60, 61, 54, 47, 55, 62, 63
			};
			dctCoeffs[zigzag[i]] = ReadSignedBits(code & 0xf) * component.QuantizationTable[i];
		}
		if (pixelsOffset < 0)
			return;
		dctCoeffs[0] = component.Dc * component.QuantizationTable[0];
		int[64] workspace;
		// IDCT pass 1
		for (int x = 0; x < 8; x++) {
			int z2 = dctCoeffs[2 * 8 + x];
			int z3 = dctCoeffs[6 * 8 + x];
			int z1 = (z2 + z3) * 4433;
			int t2 = z1 + z3 * -15137;
			int t3 = z1 + z2 * 6270;
			z2 = dctCoeffs[x];
			z3 = dctCoeffs[4 * 8 + x];
			int t0 = z2 + z3 << 13;
			int t1 = z2 - z3 << 13;
			int t10 = t0 + t3;
			int t13 = t0 - t3;
			int t11 = t1 + t2;
			int t12 = t1 - t2;
			t0 = dctCoeffs[7 * 8 + x];
			t1 = dctCoeffs[5 * 8 + x];
			t2 = dctCoeffs[3 * 8 + x];
			t3 = dctCoeffs[1 * 8 + x];
			z1 = t0 + t3;
			z2 = t1 + t2;
			z3 = t0 + t2;
			int z4 = t1 + t3;
			int z5 = (z3 + z4) * 9633;
			t0 *= 2446;
			t1 *= 16819;
			t2 *= 25172;
			t3 *= 12299;
			z1 *= -7373;
			z2 *= -20995;
			z3 *= -16069;
			z4 *= -3196;
			z3 += z5;
			z4 += z5;
			t0 += z1 + z3;
			t1 += z2 + z4;
			t2 += z2 + z3;
			t3 += z1 + z4;
			workspace[x] = t10 + t3 + (1 << 10) >> 11;
			workspace[7 * 8 + x] = t10 - t3 + (1 << 10) >> 11;
			workspace[1 * 8 + x] = t11 + t2 + (1 << 10) >> 11;
			workspace[6 * 8 + x] = t11 - t2 + (1 << 10) >> 11;
			workspace[2 * 8 + x] = t12 + t1 + (1 << 10) >> 11;
			workspace[5 * 8 + x] = t12 - t1 + (1 << 10) >> 11;
			workspace[3 * 8 + x] = t13 + t0 + (1 << 10) >> 11;
			workspace[4 * 8 + x] = t13 - t0 + (1 << 10) >> 11;
		}
		// IDCT pass 2
		for (int y = 0; y < 64; y += 8) {
			int z2 = workspace[y + 2];
			int z3 = workspace[y + 6];
			int z1 = (z2 + z3) * 4433;
			int t2 = z1 + z3 * -15137;
			int t3 = z1 + z2 * 6270;
			z2 = workspace[y];
			z3 = workspace[y + 4];
			int t0 = z2 + z3 << 13;
			int t1 = z2 - z3 << 13;
			int t10 = t0 + t3;
			int t13 = t0 - t3;
			int t11 = t1 + t2;
			int t12 = t1 - t2;
			t0 = workspace[y + 7];
			t1 = workspace[y + 5];
			t2 = workspace[y + 3];
			t3 = workspace[y + 1];
			z1 = t0 + t3;
			z2 = t1 + t2;
			z3 = t0 + t2;
			int z4 = t1 + t3;
			int z5 = (z3 + z4) * 9633;
			t0 *= 2446;
			t1 *= 16819;
			t2 *= 25172;
			t3 *= 12299;
			z1 *= -7373;
			z2 *= -20995;
			z3 *= -16069;
			z4 *= -3196;
			z3 += z5;
			z4 += z5;
			t0 += z1 + z3;
			t1 += z2 + z4;
			t2 += z2 + z3;
			t3 += z1 + z4;
			int offset = pixelsOffset + (y >> 3) * pixelsStride;
			Pixels[offset] = Clamp(128 + (t10 + t3 + (1 << 17) >> 18));
			Pixels[offset + 7] = Clamp(128 + (t10 - t3 + (1 << 17) >> 18));
			Pixels[offset + 1] = Clamp(128 + (t11 + t2 + (1 << 17) >> 18));
			Pixels[offset + 6] = Clamp(128 + (t11 - t2 + (1 << 17) >> 18));
			Pixels[offset + 2] = Clamp(128 + (t12 + t1 + (1 << 17) >> 18));
			Pixels[offset + 5] = Clamp(128 + (t12 - t1 + (1 << 17) >> 18));
			Pixels[offset + 3] = Clamp(128 + (t13 + t0 + (1 << 17) >> 18));
			Pixels[offset + 4] = Clamp(128 + (t13 - t0 + (1 << 17) >> 18));
		}
	}

	int GetYStride() => Width + 7 & ~7;

	int GetYLength() => (Height + 7 & ~7) * GetYStride();

	int GetColorBlocksH() => ((Width + 7 >> 3) + ColorSamplingH - 1) / ColorSamplingH;

	int GetColorBlocksV() => ((Height + 7 >> 3) + ColorSamplingV - 1) / ColorSamplingV;

	protected override void DoDecode!() throws ImageFormatException
	{
		if (ReadByte() != 0xff || ReadByte() != 0xd8)
			throw ImageFormatException("Not a JPEG");
		Components = 0;
		byte[4][64] quantizationTables;
		JpegHuffmanTable()[4] dcHuffmanTables;
		JpegHuffmanTable()[4] acHuffmanTables;
		JpegComponentState()[3] componentStates;
		int restartInterval = 0;
		while (ReadByte() == 0xff) {
			int code = ReadByte();
			int length = ReadWord();
			if (length < 2)
				throw ImageFormatException("Invalid segment length");
			switch (code) {

			case 0xc0: // Baseline DCT
			case 0xc1: // Extended sequential DCT
			case 0xc2: // Progressive DCT
				if (ReadByte() != 8)
					throw ImageFormatException("Only 8-bit depth supported");
				Height = ReadWord();
				Width = ReadWord();
				CheckZeroSize();
				Components = ReadByte();
				if (Components != 1 && Components != 3)
					throw ImageFormatException("Expected 1 or 3 components");
				if (length != 2 + 1 + 2 + 2 + 1 + Components * 3)
					throw ImageFormatException("Invalid segment length");
				for (int i = 0; i < Components; i++) {
					ReadByte(); // if (ReadByte() != 1 + i) throw "Invalid component";
					int samplingFactor = ReadByte();
					if (i == 0) {
						ColorSamplingH = samplingFactor >> 4;
						if (ColorSamplingH == 0 || ColorSamplingH > 4)
							throw ImageFormatException("Invalid sampling factor");
						ColorSamplingV = samplingFactor & 0xf;
						if (ColorSamplingV == 0 || ColorSamplingV > 4)
							throw ImageFormatException("Invalid sampling factor");
					}
					else if (samplingFactor != 0x11)
						throw ImageFormatException("Invalid sampling factor");
					int quantizationId = ReadByte();
					if (quantizationId > 3)
						throw ImageFormatException("Invalid quantization table");
					componentStates[i].QuantizationTable = quantizationTables[quantizationId];
				}
				break;

			case 0xc4: // Define Huffman Tables
				while (length >= 2 + 1 + 16) {
					int id = ReadByte();
					JpegHuffmanTable! huffmanTable;
					if (id < 4)
						huffmanTable = dcHuffmanTables[id];
					else if ((id & 0xec) == 0)
						huffmanTable = acHuffmanTables[id & 3];
					else
						throw ImageFormatException("Invalid DHT");
					int symbolCount = 0;
					for (int i = 0; i < 16; i++)
						symbolCount += huffmanTable.NBitCodeCount[i] = ReadByte();
					if (symbolCount > 256)
						throw ImageFormatException("Invalid DHT");
					ReadBytes(huffmanTable.Symbols, symbolCount);
					length -= 1 + 16 + symbolCount;
				}
				if (length != 2)
					throw ImageFormatException("Invalid DHT");
				break;

			case 0xdb: // Define Quantization Tables
				for (; length >= 2 + 1 + 64; length -= 1 + 64) {
					int id = ReadByte();
					if (id > 3)
						throw ImageFormatException("Invalid DQT");
					ReadBytes(quantizationTables[id], 64);
				}
				if (length != 2)
					throw ImageFormatException("Invalid DQT");
				break;

			case 0xdd: // Define Restart Interval
				if (length != 4)
					throw ImageFormatException("Invalid DRI");
				restartInterval = ReadWord();
				break;

			case 0xda: // Start Of Scan
				if (Components == 0)
					throw ImageFormatException("Missing SOF");
				if (ReadByte() != Components)
					throw ImageFormatException("Invalid components (non-interleaved?)");
				if (length != 2 + 1 + Components * 2 + 3)
					throw ImageFormatException("Invalid segment length");
				for (int i = 0; i < Components; i++) {
					ReadByte(); // if (ReadByte() != 1 + i) throw "Invalid component";
					int huffmanIds = ReadByte();
					if ((huffmanIds & 0xcc) != 0)
						throw ImageFormatException("Invalid Huffman table");
					componentStates[i].DcHuffmanTable = dcHuffmanTables[huffmanIds >> 4];
					componentStates[i].AcHuffmanTable = acHuffmanTables[huffmanIds & 3];
				}
				if (ReadByte() != 0)
					throw ImageFormatException("Invalid SOS");
				int lastCoefficient = ReadByte();
				if (lastCoefficient > 63)
					throw ImageFormatException("Invalid SOS");
				int bitPosition = ReadByte();
				if (bitPosition > 13)
					throw ImageFormatException("Invalid SOS");

				Bits = 0;
				int yStride = GetYStride();
				int yLength = GetYLength();
				int colorBlocksH = GetColorBlocksH();
				int colorBlocksV = GetColorBlocksV();
				int colorLength = Components == 3 ? colorBlocksH * colorBlocksV << 6 : 0;
				Pixels = new byte[yLength + (colorLength << 1)];
				int restartIntervalCounter = restartInterval + 1;
				int restartMarker = 0;
				for (int colorBlockY = 0; colorBlockY < colorBlocksV; colorBlockY++) {
					for (int colorBlockX = 0; colorBlockX < colorBlocksH; colorBlockX++) {
						if (restartInterval > 0) {
							if (--restartIntervalCounter == 0) {
								restartIntervalCounter = restartInterval;
								if (ReadByte() != 0xff || ReadByte() != 0xd0 + restartMarker)
									throw ImageFormatException("Expected Restart Marker");
								restartMarker = restartMarker + 1 & 7;
								Bits = 0;
								for (int i = 0; i < Components; i++)
									componentStates[i].Dc = 0;
							}
						}
						for (int v = 0; v < ColorSamplingV; v++) {
							int y = colorBlockY * ColorSamplingV + v << 3;
							for (int h = 0; h < ColorSamplingH; h++) {
								int x = colorBlockX * ColorSamplingH + h << 3;
								ReadBlock(componentStates[0], bitPosition, lastCoefficient, x < Width && y < Height ? y * yStride + x : -1, yStride);
							}
						}
						if (Components == 3) {
							int offset = yLength + (colorBlockY * colorBlocksH << 6) + (colorBlockX << 3);
							ReadBlock(componentStates[1], bitPosition, lastCoefficient, offset, colorBlocksH << 3);
							ReadBlock(componentStates[2], bitPosition, lastCoefficient, offset + colorLength, colorBlocksH << 3);
						}
					}
				}
				return;

			default: // ignore
				SkipBytes(length - 2);
				break;
			}
		}
		throw ImageFormatException("Not a JPEG");
	}

	public override int GetPixel(int x, int y)
	{
		int cY = Pixels[y * GetYStride() + x];
		if (Components != 3)
			return 0xff << 24 | cY * 0x010101;

		int colorBlocksH = GetColorBlocksH();
		int offset = GetYLength() + (y / ColorSamplingV * colorBlocksH << 3) + x / ColorSamplingH;
		int cB = Pixels[offset] - 128;
		int cR = Pixels[offset + (GetColorBlocksV() * colorBlocksH << 6)] - 128;
		int r = cY + cR * 1402 / 1000;
		int b = cY + cB * 1772 / 1000;
		int g = (cY * 1000 - r * 299 - b * 114) / 587;
		return 0xff << 24 | Clamp(r) << 16 | Clamp(g) << 8 | Clamp(b);
	}
}
